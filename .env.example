# Cloudflare R2 — S3-compatible credentials for the private aircraft registry bucket.
# These are required for the refresh pipeline to write to R2.
# Get them from: Cloudflare Dashboard → R2 → Manage R2 API tokens
MBF_R2_ACCOUNT_ID=
MBF_R2_ACCESS_KEY_ID=
MBF_R2_SECRET_ACCESS_KEY=
MBF_R2_BUCKET_NAME=

# Pipeline behaviour (optional overrides for local development)
# Source to refresh. Leave empty to refresh all configured sources.
REFRESH_SOURCE=

# Set to "true" to translate and diff without writing to R2.
DRY_RUN=false

# Consolidated feed DB output. When set, a refresh run merges every source's slice and writes the
# single feed.sqlite here; the Cloud Run deploy bakes that file into the image. Leave empty to skip
# building the feed DB.
MBF_FEED_DB_OUT=

# Google Cloud project used by `make deploy`. The feed token remains a Secret Manager binding on
# the Cloud Run service and does not belong in this file.
GCP_PROJECT_ID=

# Gemini API key for delta translation of cancellation_reason and airworthiness_class.
# Only required when a source populates one of those fields with non-null text. Get one from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Project-wide Gemini RPM limit. Match the active limit shown in Google AI Studio.
GEMINI_REQUESTS_PER_MINUTE=10
