node_modules/
dist/
coverage/
*.local
.env
.env.*
!.env.example
gha-creds-*.json
*.log
logs/
.DS_Store
__pycache__/
# Local agent scratch (worktrees, session state) stays out of git — except the shipped setup
# skill, which is a deliverable and has to survive a clone.
# `.claude/*` and not `.claude/`: git cannot re-include anything under an excluded *directory*.
# The only tracked entry is the symlink that lets Claude Code discover the skill whose real home
# is .agents/skills/ — everything else under .claude/ is local agent scratch.
.claude/*
!.claude/skills/
.bun/

# Consolidated feed DB — built by the pipeline, baked into the Cloud Run image at deploy
feed.sqlite

# Test-run scratch artifacts. Each suite cleans up after itself on success, but an
# interrupted run (Ctrl-C, crash) can leave these behind.
.tmp-test-configs/
tests/.feed-*.sqlite*
